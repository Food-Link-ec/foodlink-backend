# Base de datos Supabase
SPRING_PROFILES_ACTIVE=production
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=CAMBIAR_POR_PASSWORD_REAL

# Autenticación JWT
JWT_SECRET=CAMBIAR_POR_CLAVE_SEGURA_MINIMO_32_CARACTERES
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Servidor
SERVER_PORT=8080

# IA (Google Gemini)
GEMINI_API_KEY=CAMBIAR_POR_API_KEY_DE_GOOGLE_AI_STUDIO
GEMINI_MODEL=gemini-2.5-flash-lite
TESSERACT_DATA_PATH=
OCR_CONFIDENCE_THRESHOLD=85

# OpenAI (placeholder)
OPENAI_API_KEY=sk-placeholder

# Scheduler
RESERVA_TIMEOUT_MINUTOS=30
SCHEDULER_RESERVAS_DELAY_MS=60000
SCHEDULER_LOTES_DELAY_MS=300000
